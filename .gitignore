################################################################################
#                                                                              #
#                              .gitignore                                      #
#                                                                              #
#  This file ignores EVERYTHING by default and explicitly includes only the    #
#  files and directories required for the project.                             #
#  To add an exception, use the "!" prefix before the path.                    #
#                                                                              #
################################################################################

# ======================
# === Global Ignore  ===
# ======================
*

# ======================
# ===   Exceptions   ===
# ======================
!README.md
!LICENSE.md
!CODE_OF_CONDUCT.md
!CHANGELOG.md
!CONTRIBUTING.md
!CONTRIBUTORS.md
!ROADMAP.md
!SECURITY.md

# Core project files
!Project.toml
!.github/
!.github/**
!.codecov.yml

# Source code
!src/
!src/**

# Documentation
!docs/
!docs/**

# Tests
!test/
!test/*/
!test/**/*.jl
!test/fixtures/
!test/fixtures/*.jl

# Examples
!examples/
!examples/**

# Benchmarks (exclude JSON results)
!benchmark/
!benchmark/**
benchmark/*.json

# Exception for tests
!test/
!test/*/
!test/**/*.jl

# Test fixtures (script but not generated certs)
!test/fixtures/
!test/fixtures/*.jl

# HPACK interoperability test vectors
!test/fixtures/hpack-test-case/
!test/fixtures/hpack-test-case/**
!test/fixtures/hpack-test-case/**/*.json
!test/fixtures/hpack-test-case/**/README.md

# Interoperability tests
!test/interop/
!test/interop/**/*.jl

# gRPCClient integration test support files
!test/integration/grpcclient/
!test/integration/grpcclient/**
!test/integration/grpcclient/**/*.jl
!test/integration/grpcclient/**/*.proto

# Exception for examples
!examples/
!examples/**

# Exception for benchmarks (exclude JSON results)
!benchmark/
!benchmark/**
benchmark/*.json

# Exception for Project.toml
!Project.toml

# Exception for Github Actions
!.github/
!.github/**

# ==============================
# === Julia-Specific Ignores ===
# ==============================
# Build artifacts
/*.tar.gz
/tmp
/dist
/dist-extras
/julia
/julia.bat
/usr
/oprofile_data
/usr-staging
/Make.user
/julia-*
/deps/jlutilities/depot
/source-dist.tmp
/source-dist.tmp1

# Test results
/test/results_*.json
/test/results_*.dat
/test/deps

# Compiled files
*.expmap
*.exe
*.dll
*.dwo
*.do
*.o
*.o.tmp
*.obj
*.so
*.dylib
*.dSYM
*.h.gen
*.jl.cov
*.jl.*.cov
*.jl.mem
*.jl.*.mem
*.ji

# Performance files
/perf*

# ===============================
# === IDE/OS-Specific Ignores ===
# ===============================
# macOS
.DS_Store

# IDEs
.idea/*
.vscode/*
.zed/*
*.heapsnapshot
.cache

# ==================================
# === Buildkite-Specific Ignores ===
# ==================================
# Buildkite directory
/.buildkite

# Buildkite test data
/test/results.json

# Buildkite keys
repo_key
agent_key*

# ===========================
# === Documentation Build ===
# ===========================
# Generated documentation
docs/build/

# ===================================
# === Julia Manifest.toml (all)   ===
# ===================================
# Manifest.toml files are per-environment and should be regenerated by users
# via Pkg.instantiate(). Only Project.toml is tracked.
# Placed after the whitelist section so it overrides any `!path/**` rule that
# would otherwise include a Manifest.toml (e.g. benchmark/).
**/Manifest.toml
Manifest.toml